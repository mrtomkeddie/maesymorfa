rules_version = '2';

// Locked down by default: nothing can be read or written unless a rule below allows it.
// welshCache (the live Welsh for each piece of English) and welshUsage (the daily count) have no rule
// on purpose: only the site's /api/welsh route uses them, with the school's service account.
// News and calendar events are stored for real (below). When the site starts storing other
// real data (parents, children, staff), add a rule for that collection here.
// Never go back to "allow read, write: if true".
service cloud.firestore {
  match /databases/{database}/documents {

    // Morfa Runner class league: one document per class, holding only that class's best
    // score and number of games. No names or personal data. Anyone may read it.
    // Writes come from the site's /api/morfa-runner/leaderboard route and must:
    // - be for a real class
    // - hold only best, games and updatedAt
    // - keep best as a whole number from 0 to 200,000 that never goes down
    // - add exactly one game
    // - use the server's own clock for updatedAt
    match /morfaRunnerClasses/{classId} {
      allow read: if true;

      allow create: if isClass(classId)
        && validShape()
        && request.resource.data.games == 1;

      allow update: if isClass(classId)
        && validShape()
        && request.resource.data.best >= resource.data.best
        && request.resource.data.games == resource.data.games + 1;

      allow delete: if false;
    }

    // School staff who may edit news and events. One document per person, named with their
    // Firebase sign-in user ID and added by hand in the Firebase console. A person may read only
    // their own entry (so the admin area can check it). Nothing on the site can write here.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // News posts. Anyone may read published posts; school admins may read and change all of them.
    match /news/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validNews();
      allow delete: if isAdmin();
    }

    // Calendar events. Same access as news.
    match /calendarEvents/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validEvent();
      allow delete: if isAdmin();
    }

    // site/content records whether the school has started adding its own news and events.
    // Until it has, the public site shows sample ones (see src/lib/db/firebase.ts).
    match /site/{docId} {
      allow read: if docId == 'content';
      allow create, update: if isAdmin() && docId == 'content'
        && request.resource.data.keys().hasOnly(['newsStarted', 'eventsStarted', 'urgentNewsId'])
        && (!('newsStarted' in request.resource.data) || request.resource.data.newsStarted is bool)
        && (!('eventsStarted' in request.resource.data) || request.resource.data.eventsStarted is bool)
        && (!('urgentNewsId' in request.resource.data) || request.resource.data.urgentNewsId == null
            || (request.resource.data.urgentNewsId is string && request.resource.data.urgentNewsId.size() <= 100));
      allow delete: if false;
    }

    // School alerts: alertDevices holds one document per phone that turned alerts on, and alertLog
    // records when each urgent post's alert last went out. Both are closed to everyone, admins
    // included. Only the site's server uses them, with the school's service account, which these
    // rules do not apply to (src/lib/pushServer.ts). Phones sign up through /api/alerts/devices,
    // which checks each token with Firebase first, so nobody can fill the list with made-up phones.
    match /alertDevices/{id} {
      allow read, write: if false;
    }
    match /alertLog/{id} {
      allow read, write: if false;
    }

    // Lunch menus: the council's 3-week menu, added in the admin area twice a year.
    // Anyone may read them; school admins may add, change and delete them.
    match /lunchMenus/{menuId} {
      allow read: if true;
      allow create, update: if isAdmin() && validLunchMenu();
      allow delete: if isAdmin();
    }

    // A real calendar date as YYYY-MM-DD (isRealDay refuses 31 February and the like)
    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && isRealDay(int(value.split('-')[0]), int(value.split('-')[1]), int(value.split('-')[2]));
    }

    function validLunchMenu() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'startsOn', 'endsOn', 'weeks', 'updatedAt'])
        && d.keys().hasAll(['name', 'startsOn', 'endsOn', 'weeks'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && isDay(d.startsOn) && isDay(d.endsOn) && d.startsOn <= d.endsOn
        && d.weeks is map && d.weeks.keys().hasOnly(['1', '2', '3']) && d.weeks.keys().hasAll(['1', '2', '3'])
        && validLunchWeek(d.weeks['1']) && validLunchWeek(d.weeks['2']) && validLunchWeek(d.weeks['3'])
        && (!('updatedAt' in d) || d.updatedAt is string);
    }

    // Monday to Friday, each with all six dishes
    function validLunchWeek(w) {
      return w is map
        && w.keys().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday'])
        && w.keys().hasAll(['monday', 'tuesday', 'wednesday', 'thursday', 'friday'])
        && validLunchDay(w.monday) && validLunchDay(w.tuesday) && validLunchDay(w.wednesday)
        && validLunchDay(w.thursday) && validLunchDay(w.friday);
    }

    // Checking each of the 90 dishes as well goes over Firestore's limit on checks per save, so the
    // site turns any dish that is not text into empty text when it reads a menu (cleanLunchMenu)
    function validLunchDay(d) {
      return d is map
        && d.keys().hasOnly(['main', 'vegetarian', 'alternative', 'sides', 'salad', 'dessert'])
        && d.keys().hasAll(['main', 'vegetarian', 'alternative', 'sides', 'salad', 'dessert']);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A real date and time, exactly as the site writes them: 2026-10-20T11:00:00.000Z
    function isIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
        && isRealDay(int(value.split('-')[0]), int(value.split('-')[1]), int(value.split('T')[0].split('-')[2]));
    }

    // No 31 April or 30 February; 29 February only in leap years
    function isRealDay(year, month, day) {
      return day <= (month == 2
        ? ((year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) ? 29 : 28)
        : (month in [4, 6, 9, 11] ? 30 : 31));
    }

    function validNews() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title_en', 'title_cy', 'body_en', 'body_cy', 'date', 'category',
          'attachments', 'attachmentUrl', 'attachmentName', 'image', 'isUrgent', 'published',
          'createdBy', 'lastEdited', 'slug', 'eventId', 'eventStart', 'eventEnd'])
        && d.title_en is string && d.title_en.size() > 0 && d.title_en.size() <= 200
        && d.title_cy is string && d.title_cy.size() <= 200
        // The form takes up to 10,000 characters; escaping can make the saved HTML up to 6 times longer
        && d.body_en is string && d.body_en.size() <= 100000
        && d.body_cy is string && d.body_cy.size() <= 100000
        && isIsoDate(d.date)
        && d.slug is string && d.slug.matches('^[a-zA-Z0-9_-]{1,120}$')
        && d.isUrgent is bool
        && d.published is bool
        && d.category in ['Urgent', 'Event', 'General']
        // The post's calendar entry, when it has a day
        && (!('eventId' in d) || (d.eventId is string && d.eventId.size() > 0 && d.eventId.size() <= 100))
        && (!('eventStart' in d) || isIsoDate(d.eventStart))
        && (!('eventEnd' in d) || isIsoDate(d.eventEnd));
    }

    function validEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title_en', 'title_cy', 'description_en', 'description_cy', 'start',
          'end', 'allDay', 'isUrgent', 'showOnHomepage', 'relevantTo', 'yearGroups', 'tags',
          'attachments', 'attachmentUrl', 'attachmentName', 'published', 'newsId', 'newsSlug'])
        && d.title_en is string && d.title_en.size() > 0 && d.title_en.size() <= 200
        && d.title_cy is string && d.title_cy.size() <= 200
        && (!('description_en' in d) || (d.description_en is string && d.description_en.size() <= 20000))
        && (!('description_cy' in d) || (d.description_cy is string && d.description_cy.size() <= 20000))
        && isIsoDate(d.start)
        && (!('end' in d) || isIsoDate(d.end))
        && (!('allDay' in d) || d.allDay is bool)
        && (!('isUrgent' in d) || d.isUrgent is bool)
        && (!('relevantTo' in d) || d.relevantTo is list)
        && (!('tags' in d) || d.tags is list)
        && (!('yearGroups' in d) || d.yearGroups is list)
        && d.published is bool
        // The news post this entry belongs to, and its web address for the "Read more" link
        && (!('newsId' in d) || (d.newsId is string && d.newsId.size() > 0 && d.newsId.size() <= 100))
        && (!('newsSlug' in d) || (d.newsSlug is string && d.newsSlug.matches('^[a-zA-Z0-9_-]{1,120}$')));
    }

    function isClass(classId) {
      // Keep in step with src/lib/schoolClasses.ts
      return classId in ['bethania', 'tregoning', 'florence', 'westbury', 'trinity', 'olive'];
    }

    function validShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['best', 'games', 'updatedAt'])
        && d.keys().hasAll(['best', 'games', 'updatedAt'])
        && d.best is int && d.best >= 0 && d.best <= 200000
        && d.games is int
        && d.updatedAt == request.time;
    }
  }
}
